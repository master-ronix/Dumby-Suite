# =============================================================================
# Dumby on Railway — FULL TESTING profile (NOT production)
# Paste into @workspace/dumby -> Variables -> Raw Editor.
# Enables: live Discord bot, instant dev-guild command registration, the
# dashboard/OAuth surface, telemetry, the admin-eval gate, and the control-plane
# services. Secrets are placeholders — fill them before use.
# =============================================================================

# --- Runtime (testing) ------------------------------------------------------
NODE_ENV=development          # registers commands to DEV_GUILD_ID instantly; enables admin features
ROLE=main
LOG_LEVEL=debug
DISCORD_ADAPTER=live          # REQUIRED for the bot to appear online

# --- Discord (LIVE bot) -----------------------------------------------------
# Developer Portal -> your app -> Bot -> Reset Token -> copy.
BOT_TOKEN=
# Your test server's id (right-click server -> Copy Server ID; enable Developer Mode).
DEV_GUILD_ID=
# Your Discord user id (right-click yourself -> Copy User ID). Comma-separate several.
BOT_OWNER_IDS=

# --- Ports / bind hosts (Railway needs 0.0.0.0) -----------------------------
PORT=8080
API_PORT=8080
API_BIND_HOST=0.0.0.0
HEALTH_PORT=8081
HEALTH_BIND_HOST=0.0.0.0
METRICS_PORT=8082
METRICS_BIND_HOST=0.0.0.0
POWER_ENGINE_PORT=8083
POWER_ENGINE_BIND_HOST=0.0.0.0
CLAI_PORT=8084
SWASTIK_PORT=8085
SWASTIK_BIND_HOST=0.0.0.0
CREDENTIALS_SERVICE_PORT=8086
CREDENTIALS_SERVICE_BIND_HOST=0.0.0.0
TWILL_PORT=8090

# --- Data -------------------------------------------------------------------
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
QUEUE_REDIS_URL=${{Redis.REDIS_URL}}

# --- Security (REQUIRED) ----------------------------------------------------
INTERNAL_API_KEY=             # >= 32 chars
ENCRYPTION_ROOT_KEY=          # openssl rand -base64 32   (base64 of exactly 32 bytes)

# --- Dashboard / MDIS (OAuth2) ---------------------------------------------
# Discord Developer Portal -> OAuth2 -> add the redirect below, then copy id/secret.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://${{RAILWAY_PUBLIC_DOMAIN}}/oauth/callback

# --- Module-provenance signing (Ed25519, PKCS#8 PEM) -----------------------
BUILD_SIGNING_KEY_ID=dumby-dev-1
BUILD_SIGNING_PRIVATE_KEY=    # single line; newlines escaped as \n

# --- Control plane ----------------------------------------------------------
POWER_ENGINE_TRUSTED_SOURCES=127.0.0.1,::1
POWER_ENGINE_OPERATOR_IDS=
POWER_ENGINE_SERVICE_CREDENTIAL=
CLAI_AUTHKEY_STORAGE_URL=${{Postgres.DATABASE_URL}}

# --- Admin-tier testing -----------------------------------------------------
CORE_ADMIN_EVAL_ENABLED=true

# --- Telemetry --------------------------------------------------------------
TELEMETRY_ENABLED=false
TRACE_SAMPLE_RATE=1.0

# --- Modules ----------------------------------------------------------------
# The image bakes the first-party modules at /app/baked-modules and points
# MODULES_DIR there. Keep it there. /mnt/modules is a Railway volume, and a
# volume mounted over a directory SHADOWS whatever the image baked into it, so
# the loader finds no tier volumes and the bot boots with zero commands.
MODULES_DIR=/app/baked-modules
SWASTIK_STAGING_VOLUME_PATH=/app/baked-modules/swastik-staging
RAILWAY_RUN_UID=0
