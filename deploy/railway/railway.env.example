# =============================================================================
# Dumby on Railway — service variables (Raw Editor paste-in)
# Paste into: @workspace/dumby -> Variables -> Raw Editor
#
# Values shown are the required shape. Fill secrets before deploy.
# Everything here is validated by apps/main/src/config/env.schema.ts; a missing
# or malformed value fails the boot at Stage 02 (CONFIG_LOAD) with a field-level
# report (visible in the Deploy Logs).
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
DISCORD_ADAPTER=mock            # 'live' only once BOT_TOKEN is set

# --- Ports / bind hosts ----------------------------------------------------
# Railway injects PORT and healthchecks it. The app listens on API_PORT, so keep
# PORT and API_PORT equal. Every surface binds loopback by default -> override
# the bind host or Railway's edge cannot reach the container.
PORT=8080
API_PORT=8080
API_BIND_HOST=0.0.0.0
HEALTH_PORT=8081
HEALTH_BIND_HOST=0.0.0.0
METRICS_PORT=8082
METRICS_BIND_HOST=0.0.0.0

# --- Database (reference the Postgres service) -----------------------------
# Use ONE Postgres service. Replace "Postgres" with your service's name.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Redis (reference the Redis service) -----------------------------------
# Redis is REQUIRED: cache, shard locks, pub/sub and the BullMQ queue all use it.
REDIS_URL=${{Redis.REDIS_URL}}
QUEUE_REDIS_URL=${{Redis.REDIS_URL}}

# --- Discord ---------------------------------------------------------------
BOT_TOKEN=                      # required only when DISCORD_ADAPTER=live
DEV_GUILD_ID=900000000000000001 # 17-20 digit snowflake
BOT_OWNER_IDS=

# --- Security (REQUIRED) ---------------------------------------------------
# INTERNAL_API_KEY: >= 32 characters.
# ENCRYPTION_ROOT_KEY: base64 of EXACTLY 32 bytes  ->  openssl rand -base64 32
INTERNAL_API_KEY=change_me_to_a_random_string_of_at_least_32_chars
ENCRYPTION_ROOT_KEY=

# --- Module storage (Option A — the module root is the VOLUME) --------------
# The image ships NO modules. MODULES_DIR is the tier VOLUME MOUNT; the image's start command seeds
# the modules into it through the Swastik deploy flow on the FIRST boot of an empty volume, then runs
# the bot. The tier directories (modules-admin / modules-core / modules-standard / modules-marketplace
# + swastik-staging) live UNDER it and are derived from MODULES_DIR + each module's own tier.
MODULES_DIR=/mnt/modules
SWASTIK_STAGING_VOLUME_PATH=/mnt/modules/swastik-staging

# --- First-promotion approval (one-time) -----------------------------------
# ADR-006: the FIRST promotion of a module requires explicit human approval. The boot seed never
# approves on its own. Set this to "true" ONCE to authorise the first seed, deploy, confirm the log
# says `push-modules-lite: 8 module(s) pushed`, then REMOVE it — once the volumes hold the modules the
# seed is skipped and the approval is no longer needed.
# MODULE_SEED_HUMAN_APPROVED=true

# --- Railway volume permissions --------------------------------------------
# The image runs as the non-root `node` user; Railway mounts volumes as root.
# This lets the non-root process write to the mounted volume.
RAILWAY_RUN_UID=0
