modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Redis Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Dumby Bot"

[[workflows.workflow]]
name = "Redis Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "redis-server --port 6379 --bind 127.0.0.1 --save '' --appendonly no"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Dumby Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/dumby run start"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ENCRYPTION_KEY_CURRENT = "f13cb5beeedfe080c9787bec83366c1586939af995d81ec6b01862f002838bf4"
INTERNAL_API_KEY = "24d98b9d3ecf9b94ae0128c0e3afe6312adeabdf7885c8f6"
JWT_SIGNING_KEY = "d8532d4298491a9895f803563dc975b9f4809b7cf27a0ba7f2cc3500c259c96b"
QUEUE_REDIS_URL = "redis://127.0.0.1:6379/1"
REDIS_URL = "redis://127.0.0.1:6379/0"
