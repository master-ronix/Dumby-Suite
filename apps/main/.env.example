# =============================================================================
# DUMBY Headless Backend V1 — environment configuration
# Copy to .env for local Docker Compose use. Every key here is validated by
# src/config/env.schema.ts (Cluster: Bonds). Unknown keys are rejected in
# strict parsing mode; missing required keys fail bootstrap at Stage 02
# (CONFIG_LOAD) with a field-level error report.
# =============================================================================

# --- Process -----------------------------------------------------------------
NODE_ENV=development
NODE_OPTIONS=--enable-source-maps
LOG_LEVEL=info

# --- Ports ---------------------------------------------------------------
# Bind hosts default to loopback. Set a surface to 0.0.0.0 only when it must
# be reachable from outside the container/host, and only behind a proxy that
# terminates auth. The /admin/* surface is additionally gated by
# INTERNAL_API_KEY (x-internal-api-key) regardless of bind host.
API_BIND_HOST=127.0.0.1
API_PORT=8080
HEALTH_BIND_HOST=127.0.0.1
HEALTH_PORT=8081
METRICS_BIND_HOST=127.0.0.1
METRICS_PORT=8082
POWER_ENGINE_BIND_HOST=127.0.0.1
POWER_ENGINE_PORT=8083
CLAI_BIND_HOST=127.0.0.1
CLAI_PORT=8084
# UR-C-06: CLAI session bounds (max concurrent sessions, max bytes per session).
CLAI_MAX_SESSIONS=5
CLAI_MAX_BYTES_PER_SESSION=65536
SWASTIK_BIND_HOST=127.0.0.1
SWASTIK_PORT=8085
CREDENTIALS_SERVICE_BIND_HOST=127.0.0.1
CREDENTIALS_SERVICE_PORT=8086
# Peer URL other surfaces call for §22.8 credential issuance/verification. Under docker compose
# the credentials service runs in the `app` service, so use http://app:8086 there.
CREDENTIALS_SERVICE_URL=http://127.0.0.1:8086
CREDENTIALS_SERVICE_TIMEOUT_MS=2000
TWILL_BIND_HOST=127.0.0.1
TWILL_PORT=8090

# --- Discord (headless defaults — no live gateway/token required) ------------
# Left blank on purpose. The default runtime profile uses MockGatewayAdapter
# and never requires a real token. See src/discord/gateway.mock-adapter.ts.
BOT_TOKEN=

# §17.6 — Bearer token (user OAuth2, scope `applications.commands.permissions.update`) for editing
# per-guild command permissions (Server Settings → Integrations). Required for the INSTANT
# hide/restrict on a module disable; without it, only the batched BCCM deregistration applies.
# Discord rejects a bot token on that endpoint. Obtain a token from a guild admin via:
#   https://discord.com/api/oauth2/authorize?client_id=<APP_ID>&redirect_uri=<URI>&response_type=token&scope=applications.commands.permissions.update
DISCORD_COMMAND_PERMISSIONS_TOKEN=
# Set only in a persona process (blueprint §35.2): the persona identity this
# process boots against. Leave empty for the main bot.
PERSONA_ID=
BOT_OWNER_IDS=100000000000000001,100000000000000002
DEV_GUILD_ID=900000000000000001
DISCORD_ADAPTER=mock
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback

# --- Database ------------------------------------------------------------
DATABASE_URL=postgres://dumby:dumby_dev_password@postgres:5432/dumby
DATABASE_REPLICA_URLS=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_REPLICA_MAX_LAG_MS=1000
SLOW_QUERY_THRESHOLD_MS=500
CRITICAL_QUERY_THRESHOLD_MS=2000

# --- Cache / Redis ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CACHE_L1_MAX_ENTRIES=5000
CACHE_L1_MAX_BYTES=52428800

# --- Queues ------------------------------------------------------------------
QUEUE_REDIS_URL=redis://redis:6379/1
QUEUE_CONCURRENCY_DEFAULT=5

# --- Rate limiting / cooldowns -----------------------------------------------
RATE_LIMIT_USER_MAX=10
RATE_LIMIT_USER_WINDOW_MS=60000
RATE_LIMIT_GUILD_MAX=100
RATE_LIMIT_GUILD_WINDOW_MS=60000

# --- Event bus -----------------------------------------------------------
EVENT_BUS_MAX_EMIT_DEPTH=20
EVENT_LOOP_LAG_SHED_THRESHOLD_MS=50

# --- Sharding ------------------------------------------------------------
SHARD_COUNT=1
SHARD_RANGE=0-0
SHARD_LOCK_HEARTBEAT_MS=10000
SHARD_LOCK_RETRY_MS=2000

# --- Observability -----------------------------------------------------------
TELEMETRY_ENABLED=false
TRACE_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Security ------------------------------------------------------------
INTERNAL_API_KEY=dev_internal_api_key_change_me_32_chars_min
# Envelope-encryption root key (ADR-003): base64 of exactly 32 bytes.
# Generate with: openssl rand -base64 32
ENCRYPTION_ROOT_KEY=JF8PejG/00/nD5iuxpUtzGqh5MWW3yL1Oj6EcWYPgzM=
POWER_ENGINE_TRUSTED_SOURCES=127.0.0.1,::1
# §22.5: the independently-configured Power Engine operator allow-list (the identities that may decide
# governance approvals). Distinct from, but typically overlapping, BOT_OWNER_IDS.
POWER_ENGINE_OPERATOR_IDS=
POWER_ENGINE_SERVICE_CREDENTIAL=
CLAI_AUTHKEY_STORAGE_URL=postgres://dumby:dumby_dev_password@postgres:5432/dumby

# --- Swastik (dev/build deployment backend) -----------------------------
MODULES_DIR=/mnt/modules
SWASTIK_STAGING_VOLUME_PATH=/mnt/modules/swastik-staging
SWASTIK_LIVE_VOLUME_PATH=/mnt/modules/modules-core
# Build-provenance signing (ADR: in-process Ed25519 signer). The private key is
# PKCS#8 PEM and is never persisted; signing_keys stores public keys only.
BUILD_SIGNING_KEY_ID=
BUILD_SIGNING_PRIVATE_KEY=
# Quarantine root for refused modules; empty => <MODULES_DIR>/quarantine.
SWASTIK_QUARANTINE_PATH=

# --- Metering / MTP --------------------------------------------------------
MTP_BANDWIDTH_TOKEN_THRESHOLD_BYTES=1048576
MTP_MEMORY_TOKEN_THRESHOLD_BYTES=52428800

# --- Admin-tier dev tooling (dev-guild only, disabled by default) ------------
CORE_ADMIN_EVAL_ENABLED=false
# §17.7 BCCM — batch push dry-run (log the batch it would send, change nothing). Set false to send.
BCCM_BATCH_PUSH_DRY_RUN=true
