# =============================================================================
# DUMBY Headless Backend V1 — environment configuration
# Copy to .env for local Docker Compose use. Every key here is validated by
# src/config/env.schema.ts (Cluster: Bonds). Unknown keys are rejected in
# strict parsing mode; missing required keys fail bootstrap at Stage 02
# (CONFIG_LOAD) with a field-level error report.
# =============================================================================

# --- Process -----------------------------------------------------------------
NODE_ENV=development
NODE_OPTIONS=--enable-source-maps
LOG_LEVEL=info

# --- Ports ---------------------------------------------------------------
API_PORT=8080
HEALTH_PORT=8081
METRICS_PORT=8082
PEP_PORT=8083
CLAI_PORT=8084
SWASTIK_PORT=8085
CREDENTIALS_SERVICE_BIND_HOST=127.0.0.1
CREDENTIALS_SERVICE_PORT=8086
TWIXTER_PORT=8090

# --- Discord (headless defaults — no live gateway/token required) ------------
# Left blank on purpose. The default runtime profile uses MockGatewayAdapter
# and never requires a real token. See src/discord/gateway.mock-adapter.ts.
BOT_TOKEN=
# Set only in a persona process (blueprint §35.2): the persona identity this
# process boots against. Leave empty for the main bot.
PERSONA_ID=
BOT_OWNER_IDS=100000000000000001,100000000000000002
DEV_GUILD_ID=900000000000000001
DISCORD_ADAPTER=mock
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback

# --- Database ------------------------------------------------------------
DATABASE_URL=postgres://dumby:dumby_dev_password@postgres:5432/dumby
DATABASE_REPLICA_URLS=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_REPLICA_MAX_LAG_MS=1000
SLOW_QUERY_THRESHOLD_MS=500
CRITICAL_QUERY_THRESHOLD_MS=2000

# --- Cache / Redis ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CACHE_L1_MAX_ENTRIES=5000
CACHE_L1_MAX_BYTES=52428800

# --- Queues ------------------------------------------------------------------
QUEUE_REDIS_URL=redis://redis:6379/1
QUEUE_CONCURRENCY_DEFAULT=5

# --- Rate limiting / cooldowns -----------------------------------------------
RATE_LIMIT_USER_MAX=10
RATE_LIMIT_USER_WINDOW_MS=60000
RATE_LIMIT_GUILD_MAX=100
RATE_LIMIT_GUILD_WINDOW_MS=60000

# --- Event bus -----------------------------------------------------------
EVENT_BUS_MAX_EMIT_DEPTH=20
EVENT_LOOP_LAG_SHED_THRESHOLD_MS=50

# --- Sharding ------------------------------------------------------------
SHARD_COUNT=1
SHARD_RANGE=0-0
SHARD_LOCK_HEARTBEAT_MS=10000
SHARD_LOCK_RETRY_MS=2000

# --- Observability -----------------------------------------------------------
TELEMETRY_ENABLED=false
TRACE_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Security ------------------------------------------------------------
INTERNAL_API_KEY=dev_internal_api_key_change_me_32_chars_min
# Envelope-encryption root key (ADR-003): base64 of exactly 32 bytes.
# Generate with: openssl rand -base64 32
ENCRYPTION_ROOT_KEY=JF8PejG/00/nD5iuxpUtzGqh5MWW3yL1Oj6EcWYPgzM=
PEP_TRUSTED_SOURCES=127.0.0.1,::1
CLAI_MFA_ISSUER=DUMBY-CLAI
CLAI_AUTHKEY_STORAGE_URL=postgres://dumby:dumby_dev_password@postgres:5432/dumby
CLAI_BREAK_GLASS_SCRIPT_URL=

# --- Swastik (dev/build deployment backend) -----------------------------
MODULES_DIR=/mnt/modules
SWASTIK_STAGING_VOLUME_PATH=/mnt/modules/swastik-staging
SWASTIK_LIVE_VOLUME_PATH=/mnt/modules/modules-core

# --- Metering / MTP --------------------------------------------------------
MTP_BANDWIDTH_TOKEN_THRESHOLD_BYTES=1048576
MTP_MEMORY_TOKEN_THRESHOLD_BYTES=52428800

# --- Admin-tier dev tooling (dev-guild only, disabled by default) ------------
CORE_ADMIN_EVAL_ENABLED=false
