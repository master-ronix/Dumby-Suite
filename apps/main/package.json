{
  "name": "@workspace/dumby",
  "version": "1.0.0-v1",
  "private": true,
  "description": "DUMBY Unified Modular Bot System \u2014 modular Discord bot framework.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "prebuild": "pnpm --filter @workspace/swastik build",
    "build": "tsc -p tsconfig.json",
    "predev": "pnpm --filter @workspace/swastik build",
    "dev": "tsx watch src/bootstrap/bootstrap.ts",
    "start": "node dist/entry/main.js",
    "start:dev": "tsx src/entry/main.ts",
    "cli": "tsx src/cli/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "migrate": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "migrate:status": "tsx scripts/migrate.ts status",
    "seed": "tsx scripts/seed.ts",
    "verify:env": "tsx scripts/verify-env.ts",
    "verify:all": "tsx scripts/verify-all.ts",
    "swastik:deploy": "tsx scripts/swastik-deploy.ts",
    "build:modules": "tsx scripts/build-modules.ts",
    "push:modules": "tsx scripts/push-modules.ts",
    "test:flow": "vitest run --config vitest.flow.config.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@workspace/swastik": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^5.28.0",
    "discord.js": "^14.17.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "ioredis": "^5.4.1",
    "knex": "^3.1.0",
    "lru-cache": "^11.5.3",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "ssh2": "^1.17.0",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "^1.15.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-import": "^2.32.0",
    "ioredis-mock": "^8.13.1",
    "prettier": "^3.9.10",
    "tsx": "catalog:",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
