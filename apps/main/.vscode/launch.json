{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Bootstrap (mock adapter)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@workspace/dumby", "exec", "tsx", "--inspect"],
      "args": ["src/entry/main.ts"],
      "cwd": "${workspaceFolder}/apps/main",
      "env": {
        "DISCORD_ADAPTER": "mock",
        "NODE_ENV": "development"
      },
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/main/src/**/*.js"],
      "resolveSourceMapLocations": ["${workspaceFolder}/**"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Current Test File",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@workspace/dumby", "exec", "vitest"],
      "args": ["run", "--reporter=verbose", "${relativeFile}"],
      "cwd": "${workspaceFolder}/apps/main",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
