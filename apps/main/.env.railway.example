# ============================================================================
# Dumby bot — Railway deployment environment
# ============================================================================
# These are the ONLY six variables with no default in src/config/env.schema.ts,
# so the bot fails Stage 02 (CONFIG_LOAD) with `environment-validation-failed`
# until all six are set. Everything else in .env.example has a safe default.
#
# Provision Railway Postgres + Redis first, then wire these in.
# ----------------------------------------------------------------------------

# Required — Discord development guild id (17-20 digit snowflake).
DEV_GUILD_ID=900000000000000001

# Required — Postgres. Reference the Railway Postgres plugin.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Railway Postgres requires TLS; enable this if the connection is refused.
DATABASE_SSL=true

# Required — Redis: cache on logical db 0, queue on db 1.
REDIS_URL=${{Redis.REDIS_URL}}/0
QUEUE_REDIS_URL=${{Redis.REDIS_URL}}/1

# Required — at least 32 characters.  Generate: openssl rand -hex 32
INTERNAL_API_KEY=replace_with_openssl_rand_hex_32

# Required — base64 of exactly 32 bytes.  Generate: openssl rand -base64 32
ENCRYPTION_ROOT_KEY=replace_with_openssl_rand_base64_32

# ----------------------------------------------------------------------------
# Optional on Railway
# ----------------------------------------------------------------------------
# Bind the health surface to all interfaces so the platform probe can reach it.
# Leave the /admin/* API surface on loopback — it is gated by INTERNAL_API_KEY.
HEALTH_BIND_HOST=0.0.0.0

# The bot runs headless against the mock Discord gateway by default, so no
# BOT_TOKEN is required. Set DISCORD_ADAPTER=live (and BOT_TOKEN) to go live.
DISCORD_ADAPTER=mock
